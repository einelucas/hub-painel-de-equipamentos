# Ambiente da suíte de testes — SOMENTE PostgreSQL LOCAL e descartável.
# A suíte de integração TRUNCA todas as tabelas após cada teste.
#
# NUNCA apontar este arquivo para Neon, DEV ou produção.
#
# O conftest recusa (antes de importar a aplicação) qualquer destino que não
# atenda a TODAS as regras: APP_ENV=test, ALLOW_DESTRUCTIVE_TESTS=true, host
# localhost/127.0.0.1/::1 e banco terminando em _test — tanto em DATABASE_URL
# quanto em MIGRATION_DATABASE_URL. Variáveis já definidas no ambiente têm
# prioridade sobre este arquivo.
APP_ENV=test
ALLOW_DESTRUCTIVE_TESTS=true
DATABASE_URL=postgresql://equipamentos:equipamentos@localhost:5433/painel_equipamentos_test
MIGRATION_DATABASE_URL=postgresql://equipamentos:equipamentos@localhost:5433/painel_equipamentos_test
ALLOW_TEST_DB_MIGRATIONS=true
CORS_ORIGINS=http://localhost:3000
KEYCLOAK_ISSUER=
KEYCLOAK_AUDIENCE=
KEYCLOAK_JWKS_URL=
DEV_AUTH_ENABLED=true
LOG_LEVEL=INFO
