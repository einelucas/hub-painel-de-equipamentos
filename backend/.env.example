# Copie este arquivo para .env e preencha os valores do ambiente.
APP_ENV=development
DATABASE_URL=postgresql://equipamentos:equipamentos@localhost:5433/painel_equipamentos
MIGRATION_DATABASE_URL=postgresql://equipamentos:equipamentos@localhost:5433/painel_equipamentos
ALLOW_TEST_DB_MIGRATIONS=true
CORS_ORIGINS=http://localhost:3000

# Keycloak / OIDC
KEYCLOAK_ISSUER=
KEYCLOAK_AUDIENCE=
KEYCLOAK_JWKS_URL=
KEYCLOAK_ALLOWED_ALGORITHMS=RS256
JWKS_CACHE_TTL_SECONDS=3600

# Bypass exclusivo para desenvolvimento local.
DEV_AUTH_ENABLED=true
DEV_AUTH_USER_EMAIL=dev@example.com

# Login local por e-mail e senha (usuários cadastrados via `python -m app.modules.local_auth`).
LOCAL_AUTH_SESSION_HOURS=12

LOG_LEVEL=INFO

# Arquivos de contratos. Em produção use `s3`; endpoint vazio usa AWS S3.
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./var/contract-files
STORAGE_S3_BUCKET=
STORAGE_S3_ENDPOINT_URL=
STORAGE_S3_REGION=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_S3_PREFIX=

# E-mails: provedor de envio graph ou resend. Log nunca envia; sandbox só para inbox.
NOTIFICATION_PROVIDER=graph
RESEND_API_KEY=
RESEND_FROM_EMAIL=
NOTIFICATION_MODE=log
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SENDER=
NOTIFICATION_TEST_INBOX=
NOTIFICATION_TIMEZONE=America/Sao_Paulo
